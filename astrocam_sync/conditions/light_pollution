def bortle_to_sky_brightness(bortle: int) -> float:
    """
    Convert Bortle scale to sky brightness.
    
    Args:
        bortle: Bortle scale level (1-9)
        
    Returns:
        Sky brightness in mag/arcsec²
    """
    if bortle in BORTLE_SCALE:
        return BORTLE_SCALE[bortle].sky_brightness
    
    # Clamp to valid range
    bortle = max(1, min(9, bortle))
    return BORTLE_SCALE[bortle].sky_brightness


def sky_brightness_to_bortle(sky_brightness: float) -> int:
    """
    Estimate Bortle scale from sky brightness measurement.
    
    Args:
        sky_brightness: Sky brightness in mag/arcsec²
        
    Returns:
        Estimated Bortle scale level (1-9)
    """
    # Find closest Bortle class
    min_diff = float('inf')
    closest_bortle = 5
    
    for level, bortle_class in BORTLE_SCALE.items():
        diff = abs(bortle_class.sky_brightness - sky_brightness)
        if diff < min_diff:
            min_diff = diff
            closest_bortle = level
    
    return closest_bortle


def get_bortle_description(bortle: int) -> BortleClass:
    """
    Get full Bortle scale description.
    
    Args:
        bortle: Bortle scale level (1-9)
        
    Returns:
        BortleClass with all information
    """
    bortle = max(1, min(9, bortle))
    return BORTLE_SCALE[bortle]


def assess_sky_quality(sky_brightness: float) -> Dict[str, any]:
    """
    Comprehensive sky quality assessment.
    
    Args:
        sky_brightness: Measured sky brightness (mag/arcsec²)
        
    Returns:
        Dict with quality assessment
    """
    bortle = sky_brightness_to_bortle(sky_brightness)
    bortle_info = BORTLE_SCALE[bortle]
    
    # Quality rating
    if bortle <= 2:
        quality = "Excellent"
        color = "green"
    elif bortle <= 4:
        quality = "Good"
        color = "lightgreen"
    elif bortle <= 6:
        quality = "Fair"
        color = "yellow"
    else:
        quality = "Poor"
        color = "red"
    
    # Astrophotography suitability
    if bortle <= 3:
        astro_suitable = "Excellent for all targets"
    elif bortle <= 5:
        astro_suitable = "Good for bright targets, filters recommended"
    elif bortle <= 6:
        astro_suitable = "Challenging, narrowband filters essential"
    else:
        astro_suitable = "Very difficult, planetary/lunar only"
    
    return {
        "bortle": bortle,
        "bortle_name": bortle_info.name,
        "sky_brightness": sky_brightness,
        "quality": quality,
        "quality_color": color,
        "naked_eye_limit": bortle_info.naked_eye_limit,
        "milky_way": bortle_info.milky_way_visibility,
        "astrophotography": astro_suitable,
        "description": bortle_info.description
    }


def estimate_light_pollution_impact(
    bortle: int,
    target_brightness: float
) -> Dict[str, any]:
    """
    Estimate how light pollution affects a specific target.
    
    Args:
        bortle: Bortle scale level
        target_brightness: Target surface brightness (mag/arcsec²)
        
    Returns:
        Impact assessment
    """
    sky_brightness = bortle_to_sky_brightness(bortle)
    
    # Contrast calculation
    contrast = sky_brightness - target_brightness
    
    # Impact assessment
    if contrast > 5:
        impact = "Minimal"
        visibility = "Excellent"
        dr_loss = 0.5
    elif contrast > 3:
        impact = "Low"
        visibility = "Good"
        dr_loss = 1.5
    elif contrast > 1:
        impact = "Moderate"
        visibility = "Fair"
        dr_loss = 3.0
    elif contrast > 0:
        impact = "High"
        visibility = "Poor"
        dr_loss = 5.0
    else:
        impact = "Severe"
        visibility = "Very Poor"
        dr_loss = 7.0
    
    # Filter recommendations
    if bortle <= 3:
        filter_rec = "Optional - natural color preferred"
    elif bortle <= 5:
        filter_rec = "Light pollution filter recommended (UHC, L-Pro)"
    elif bortle <= 7:
        filter_rec = "Narrowband filters essential (Ha, OIII, SII)"
    else:
        filter_rec = "Narrowband only, broadband not viable"
    
    return {
        "impact": impact,
        "visibility": visibility,
        "contrast": contrast,
        "dynamic_range_loss_stops": dr_loss,
        "filter_recommendation": filter_rec,
        "bortle": bortle,
        "sky_brightness": sky_brightness,
        "target_brightness": target_brightness
    }


